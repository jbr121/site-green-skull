  },
  "dependencies": {
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "multer": "1.4.5-lts.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "cypress": "^13.17.0",
    "start-server-and-test": "^2.1.5"
  }
}
