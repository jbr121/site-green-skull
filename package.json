{
  "name": "gold-skull",
  "version": "1.0.0",
  "description": "Loja GOLD SKULL — catálogo dinâmico com painel de produtos",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:test": "cross-env NODE_ENV=test PORT=3001 node server.js",
    "import": "node scripts/import-kyte.js",
    "backup": "node scripts/backup-db.js",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
